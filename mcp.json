{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "lklaud": {
      "type": "streamable-http",
      "url": "https://dev.nns.in.ua/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "profile:read",
              "schedule:read"
            ]
          }
        }
      }
    }
  }
}
